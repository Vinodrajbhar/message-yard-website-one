# ==============================================================================
# MessageYard Environment Configuration Template
# ==============================================================================

# --- Contact & Demo Form Destination ---
CONTACT_TO_EMAIL=sales@messageyard.com

# --- SMTP Server Credentials (e.g. Gmail, AWS SES, SendGrid, Postmark, Brevo) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM="MessageYard Inquiries" <your-email@gmail.com>

# --- Cloudflare R2 Video & Media Storage (S3-Compatible) ---
# Found in Cloudflare Dashboard -> R2 -> Overview -> Account Details
CLOUDFLARE_R2_ACCOUNT_ID=your-cloudflare-account-id

# Found in Cloudflare Dashboard -> R2 -> Manage R2 API Tokens -> Create API Token
CLOUDFLARE_R2_ACCESS_KEY_ID=your-r2-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key

# Name of your R2 bucket (e.g. messageyard-media)
CLOUDFLARE_R2_BUCKET_NAME=messageyard-media
